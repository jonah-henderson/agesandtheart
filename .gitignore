# Gradle
.gradle/
build/
out/
!gradle/wrapper/gradle-wrapper.jar

# Kotlin 2.x build cache
.kotlin/

# Logs written by anything that puts Minecraft on the classpath — including the terrain preview
logs/

# Minecraft dev run directories (Loom)
run/
runs/
run-*/
*/run/

# Loom / Architectury caches
.architectury-transformer/
*-remapped/

# IDEs
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
.settings/
.classpath
.project
bin/
.eclipse/

# OS / misc
.DS_Store
Thumbs.db
*.hprof

# Local one-off helper scripts (not part of the mod)
/rehome-session.sh

# Reference images dropped in the repo root (kept locally, not committed).
# Mod textures live under */src/main/resources/assets/ and are unaffected.
/*.jpg
/*.jpeg
/*.png
/*.webp

# The word forge remembers what a server carried, and `./gradlew clean` must not throw that away.
/.authoring/

# Release outputs, and the beta settings a release reads (scripts/release/beta.example.properties)
/dist/
/.release/
__pycache__/

# Image editors' working files live outside the repository; only exports are committed
*.xcf
*.pxo
*.bbmodel
