{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://github.com/jonah-henderson/agesandtheart",
    "sources": "https://github.com/jonah-henderson/agesandtheart",
    "issues": "https://github.com/jonah-henderson/agesandtheart/issues"
  },
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "co.voik.agesandtheart.AgesAndTheArtKt::init"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "co.voik.agesandtheart.AgesAndTheArtClientKt::initClient"
      }
    ]
  },
  "mixins": [
    "agesandtheart.mixins.json",
    "agesandtheart-fabric.mixins.json"
  ],
  "accessWidener": "${mod_id}.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-language-kotlin": ">=${flk_version}",
    "ephemeris": "${ephemeris_range_fabric}",
    "forgeconfigapiport": "${config_port_range}"
  }
}
