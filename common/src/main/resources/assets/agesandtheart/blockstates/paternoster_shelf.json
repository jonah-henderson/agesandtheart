{
  "_comment": "[AI] A length of a standing paternoster's chain: the chain always, the platform at rest. `shows=platform` is never placed; `PaternosterShelfRenderer` draws it sliding while the loop turns. Stand-ins on vanilla's iron chain and spruce until the asset pass, modelled facing north.",
  "multipart": [
    {
      "when": {
        "shows": "chain_and_platform|chain"
      },
      "apply": {
        "model": "agesandtheart:block/paternoster_shelf_chain"
      }
    },
    {
      "when": {
        "shows": "chain_and_platform|platform",
        "facing": "north"
      },
      "apply": {
        "model": "agesandtheart:block/paternoster_shelf_platform"
      }
    },
    {
      "when": {
        "shows": "chain_and_platform|platform",
        "facing": "east"
      },
      "apply": {
        "model": "agesandtheart:block/paternoster_shelf_platform",
        "y": 90
      }
    },
    {
      "when": {
        "shows": "chain_and_platform|platform",
        "facing": "south"
      },
      "apply": {
        "model": "agesandtheart:block/paternoster_shelf_platform",
        "y": 180
      }
    },
    {
      "when": {
        "shows": "chain_and_platform|platform",
        "facing": "west"
      },
      "apply": {
        "model": "agesandtheart:block/paternoster_shelf_platform",
        "y": 270
      }
    }
  ]
}
