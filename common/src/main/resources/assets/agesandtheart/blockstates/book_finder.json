      },
      "apply": {
        "model": "agesandtheart:block/book_finder_left_paddle"
      }
    },
    {
      "when": {
        "part": "right_paddle"
      },
      "apply": {
        "model": "agesandtheart:block/book_finder_right_paddle"
      }
    },
    {
      "when": {
        "part": "lectern"
      },
      "apply": {
        "model": "agesandtheart:block/book_finder_lectern"
      }
    },
    {
      "when": {
        "part": "book_surface"
      },
      "apply": {
        "model": "agesandtheart:block/book_finder_book_surface"
      }
    }
  ]
}
