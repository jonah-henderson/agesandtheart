        "part": "static",
        "facing": "east"
      },
      "apply": {
        "model": "agesandtheart:block/book_finder_frame",
        "y": 90
      }
    },
    {
      "when": {
        "part": "static",
        "facing": "south"
      },
      "apply": {
        "model": "agesandtheart:block/book_finder_frame",
        "y": 180
      }
    },
    {
      "when": {
        "part": "static",
        "facing": "west"
      },
      "apply": {
        "model": "agesandtheart:block/book_finder_frame",
        "y": 270
      }
    },
    {
      "when": {
        "part": "chassis"
      },
      "apply": {
        "model": "agesandtheart:block/book_finder_chassis"
      }
    },
    {
      "when": {
        "part": "extractor"
      },
      "apply": {
        "model": "agesandtheart:block/book_finder_extractor"
      }
    },
    {
      "when": {
        "part": "rotator"
      },
      "apply": {
        "model": "agesandtheart:block/book_finder_rotator"
      }
    },
    {
      "when": {
