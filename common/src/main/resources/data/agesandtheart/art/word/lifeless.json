{
  "_comment": "Before a place, nothing lives there (Jonah): `lifeless sea` has no fish but the undead, `lifeless landmass` nothing but the undead.",
  "meanings": [
    {
      "sets": {
        "temperature": "-0.9..-0.4"
      },
      "must_always_apply": true
    },
    {
      "sets": {
        "humidity": "-0.9..-0.4"
      },
      "must_always_apply": true
    },
    {
      "restricts": {
        "climate": {
          "barren": ">0.7"
        }
      },
      "must_always_apply": true
    },
    {
      "excludes": {
        "inhabitants": [
          "#aquatic",
          "!#undead"
        ]
      },
      "must_always_apply": true,
      "offered_to": [
        "sea",
        "waters"
      ]
    },
    {
      "excludes": {
        "inhabitants": [
          "#mobs",
          "!#undead"
        ]
      },
      "must_always_apply": true,
      "offered_to": [
        "landmass"
      ]
    },
    {
      "excludes": {
        "inhabitants": [
          "#cavernous"
        ]
      },
      "must_always_apply": true,
      "offered_to": [
        "underground"
      ]
    }
  ]
}
