{
  "_comment": [
    "Broken into pieces and strewn: a landmass in scattered parts, every part leaning scattered, and whatever",
    "stands set further apart.",
    "`scattered clouds`: less of the sky in cloud, and that in small bits."
  ],
  "meanings": [
    {
      "bends": {
        "landmass.spacing": "0.3..1.0"
      },
      "must_always_apply": true
    },
    {
      "sets": {
        "structures.spacing": "0.3..1.0"
      },
      "must_always_apply": true
    },
    {
      "restricts": {
        "landmass": {
          "scattered": ">0.3"
        }
      },
      "must_always_apply": true
    },
    {
      "leans": {
        "all": {
          "#scattered": 0.8
        }
      },
      "must_always_apply": true
    },
    {
      "sets": {
        "cover": "-0.5..-0.2",
        "clumping": "-1.0..-0.6"
      },
      "must_always_apply": true,
      "offered_to": [
        "clouds"
      ]
    }
  ]
}
