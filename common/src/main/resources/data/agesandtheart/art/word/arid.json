{
  "_comment": [
    "Drought underfoot, where `parched` is drought overhead: dry, bare country, and the ground it is made",
    "of. Every arid Age is dressed in something sandy -- sand, red sand, sandstone, gravel, terracotta --",
    "drawn by tag, and its rock is offered the same; the rain is offered away."
  ],
  "meanings": [
    {
      "sets": {
        "temperature": "0.2..0.8"
      },
      "must_always_apply": true
    },
    {
      "sets": {
        "humidity": "-0.95..-0.5"
      },
      "must_always_apply": true
    },
    {
      "sets": {
        "surface.material": "#sandy"
      },
      "must_always_apply": true
    },
    {
      "sets": {
        "structures.material": "#sandy"
      },
      "unaimed_chance_to_apply": 0.0
    },
    {
      "restricts": {
        "landmass": {
          "dry": ">0.3",
          "barren": ">0.5"
        }
      },
      "must_always_apply": true
    },
    {
      "restricts": {
        "climate": {
          "dry": ">0.3",
          "barren": ">0.5"
        }
      },
      "must_always_apply": true
    },
    {
      "leans": {
        "biomes": {
          "#dry": 1.0,
          "#sandy": 1.0
        }
      },
      "must_always_apply": true
    },
    {
      "leans": {
        "features": {
          "#dry": 1.0
        }
      },
      "must_always_apply": true
    },
    {
      "sets": {
        "stone": "#sandy"
      }
    },
    {
      "sets": {
        "weather.frequency": "-1.0..-0.5"
      }
    },
    {
      "leans": {
        "inhabitants": {
          "#dry": 0.8
        }
      }
    }
  ]
}
