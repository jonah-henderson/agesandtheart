{
  "_comment": [
    "dni_city_generic_degradation, with the ice box's chest filled from the quarantine table instead.",
    "See dni_city_library for how a room is routed; the degradation rules are copied from the generic list,",
    "so change those there first."
  ],
  "processors": [
    {
      "integrity": 0.95,
      "processor_type": "minecraft:block_rot",
      "rottable_blocks": "#minecraft:ancient_city_replaceable"
    },
    {
      "processor_type": "minecraft:rule",
      "rules": [
        {
          "input_predicate": {
            "block": "minecraft:deepslate_bricks",
            "predicate_type": "minecraft:random_block_match",
            "probability": 0.3
          },
          "location_predicate": {
            "predicate_type": "minecraft:always_true"
          },
          "output_state": "minecraft:cracked_deepslate_bricks"
        },
        {
          "input_predicate": {
            "block": "minecraft:deepslate_tiles",
            "predicate_type": "minecraft:random_block_match",
            "probability": 0.3
          },
          "location_predicate": {
            "predicate_type": "minecraft:always_true"
          },
          "output_state": "minecraft:cracked_deepslate_tiles"
        },
        {
          "input_predicate": {
            "block": "minecraft:soul_lantern",
            "predicate_type": "minecraft:random_block_match",
            "probability": 0.05
          },
          "location_predicate": {
            "predicate_type": "minecraft:always_true"
          },
          "output_state": "minecraft:air"
        }
      ]
    },
    {
      "processor_type": "minecraft:protected_blocks",
      "value": "#minecraft:features_cannot_replace"
    },
    {
      "processor_type": "minecraft:rule",
      "rules": [
        {
          "input_predicate": {
            "predicate_type": "minecraft:block_match",
            "block": "minecraft:sculk_sensor"
          },
          "location_predicate": {
            "predicate_type": "minecraft:always_true"
          },
          "output_state": "minecraft:air"
        }
      ]
    },
    {
      "processor_type": "agesandtheart:loot_table_swap",
      "swaps": {
        "minecraft:chests/ancient_city_ice_box": "agesandtheart:chests/dni_city/quarantine",
        "minecraft:chests/ancient_city": "agesandtheart:chests/dni_city"
      }
    }
  ]
}
