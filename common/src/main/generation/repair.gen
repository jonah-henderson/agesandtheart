start     world
terminals word

world = age <temperate_world> x2 | age <frozen_world> x2 | age <parched_world>

temperate_world = landmass <settled_land> sea <some_sea> depths riddled biomes verdant surface features spawns atmosphere phenomena sky <mild_sky> structures untouched climate temperate

frozen_world = landmass <harsh_land> sea <some_sea> depths unbroken biomes surface features spawns atmosphere phenomena sky <cold_sky> structures untouched climate frozen

parched_world = landmass <dry_land> sea <dry_sea> depths riddled biomes surface features spawns atmosphere phenomena sky clear structures untouched climate parched

some_sea = drowned x8 | open

dry_sea = open x2 | burning

settled_land = worn x2 | ordered | scattered

mild_sky = clear | starlit

harsh_land = sheer x2 | worn

cold_sky = overcast | starless

dry_land = flat x2 | worn
