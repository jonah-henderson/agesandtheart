start     world
terminals word

# Every clause leads with what is said and closes with the page it is said about (design §4.3.1), so a
# world reads as "an Age with a worn landmass, a drowned sea, riddled rock…" rather than naming each
# part and then filling it.

world = [temperate_world]@2 | [frozen_world]@2 | [parched_world]

temperate_world = age [settled_land] landmass [some_sea] sea riddled rock underground verdant biomes surface grass leaves features spawns phenomena [mild_sky] sky clouds [mild_stars] stars aurora rainbow sun moon air waters weather untouched structures temperate climate

frozen_world = age [harsh_land] landmass [some_sea] sea unbroken rock unbroken underground biomes surface grass leaves features spawns phenomena [cold_sky] sky clouds [cold_stars] stars aurora rainbow sun moon air waters weather untouched structures frozen climate

parched_world = age [dry_land] landmass [dry_sea] sea riddled rock underground biomes surface grass leaves features spawns phenomena [dry_sky] sky clouds [dry_stars] stars aurora rainbow sun moon air waters weather untouched structures parched climate

some_sea = drowned@8 | open

dry_sea = open@2 | burning

settled_land = worn@2 | ordered | scattered

mild_sky = clear@2 | overcast

dry_sky = clear

mild_stars = bright@2 | starless

cold_stars = starless@2 | bright

dry_stars = bright

harsh_land = sheer@2 | worn

cold_sky = overcast

dry_land = flat@2 | worn
