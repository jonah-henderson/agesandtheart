start     world
terminals word

# Every clause leads with what is said and closes with the page it is said about (design §4.3.1), so a
# world reads as "an Age with a worn landmass, a drowned sea, riddled depths…" rather than naming each
# part and then filling it.

world = <temperate_world> x2 | <frozen_world> x2 | <parched_world>

temperate_world = age <settled_land> landmass <some_sea> sea riddled depths verdant biomes surface features spawns phenomena <mild_sky> sky untouched structures temperate climate <mild_air> atmosphere

frozen_world = age <harsh_land> landmass <some_sea> sea unbroken depths biomes surface features spawns phenomena <cold_sky> sky untouched structures frozen climate <cold_air> atmosphere

parched_world = age <dry_land> landmass <dry_sea> sea riddled depths biomes surface features spawns phenomena clear sky untouched structures parched climate <dry_air> atmosphere

mild_air = clear x2 | murky

cold_air = smothered x2 | murky

dry_air = dusty x2 | rainless

some_sea = drowned x8 | open

dry_sea = open x2 | burning

settled_land = worn x2 | ordered | scattered

mild_sky = clear | starlit

harsh_land = sheer x2 | worn

cold_sky = overcast | starless

dry_land = flat x2 | worn
