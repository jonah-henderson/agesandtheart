start     name
terminals text

name = [syllable] [syllable]@3 | [syllable] [syllable] [syllable]@2 | [syllable]

syllable = [onset] [nucleus]@3 | [onset] [nucleus] [coda]@2

onset = r@3 | t@3 | n@3 | k@2 | g@2 | s@2 | m@2 | l@2 | d | b | v | sh | th | ts

nucleus = a@4 | e@3 | i@3 | o@2 | u@2 | ee | oo | ah

coda = n@3 | r@3 | l@2 | s@2 | t@2 | m | th | sh
